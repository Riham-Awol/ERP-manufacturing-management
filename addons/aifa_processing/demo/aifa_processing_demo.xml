<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== Chambers ===================== -->
    <record id="dryer_td01" model="aifa.dehydrator">
        <field name="name">Tunnel Dehydrator 1</field>
        <field name="code">TD-01</field>
        <field name="sequence">10</field>
        <field name="dryer_type">tunnel</field>
        <field name="workcenter_id" ref="workcenter_dry"/>
        <field name="tray_capacity">120</field>
        <field name="kg_per_tray">4.0</field>
        <field name="rated_power_kw">24.0</field>
        <field name="energy_tariff">2.12</field>
        <field name="temp_min">45.0</field>
        <field name="temp_max">70.0</field>
        <field name="has_datalogger" eval="True"/>
        <field name="note">Known cold spot on the last two trolleys; rotate trolleys at the 6-hour mark.</field>
    </record>
    <record id="dryer_td02" model="aifa.dehydrator">
        <field name="name">Tunnel Dehydrator 2</field>
        <field name="code">TD-02</field>
        <field name="sequence">20</field>
        <field name="dryer_type">tunnel</field>
        <field name="workcenter_id" ref="workcenter_dry"/>
        <field name="tray_capacity">120</field>
        <field name="kg_per_tray">4.0</field>
        <field name="rated_power_kw">24.0</field>
        <field name="has_datalogger" eval="True"/>
    </record>
    <record id="dryer_cd01" model="aifa.dehydrator">
        <field name="name">Tray Cabinet Dehydrator 1</field>
        <field name="code">CD-01</field>
        <field name="sequence">30</field>
        <field name="dryer_type">cabinet</field>
        <field name="workcenter_id" ref="workcenter_dry"/>
        <field name="tray_capacity">60</field>
        <field name="kg_per_tray">3.0</field>
        <field name="rated_power_kw">9.0</field>
    </record>
    <record id="dryer_sd01" model="aifa.dehydrator">
        <field name="name">Hybrid Solar Dryer (pilot)</field>
        <field name="code">SD-01</field>
        <field name="sequence">40</field>
        <field name="dryer_type">solar</field>
        <field name="tray_capacity">40</field>
        <field name="kg_per_tray">3.0</field>
        <field name="rated_power_kw">2.0</field>
        <field name="energy_tariff">0.0</field>
        <field name="note">P4G-funded pilot. Daytime only; back-up electric element for the night tail.</field>
    </record>

