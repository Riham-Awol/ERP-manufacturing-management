    <record id="bom_prep_pine" model="mrp.bom">
        <field name="product_tmpl_id" ref="aifa_base.product_prep_pineapple_product_template"/>
        <field name="product_qty">55.0</field>
        <field name="product_uom_id" ref="uom.product_uom_kgm"/>
        <field name="type">normal</field>
        <field name="code">PREP-PINE v1.0</field>
        <field name="aifa_stage">prep</field>
        <field name="aifa_crop_id" ref="aifa_base.crop_pineapple"/>
        <field name="aifa_version">1.0</field>
        <field name="aifa_change_note">Baseline from the 2026 discovery trials: 100 kg of Grade A Smooth Cayenne yields 55 kg of 8 mm slices after crown, shell and core removal.</field>
    </record>
    <record id="bom_prep_pine_l1" model="mrp.bom.line">
        <field name="bom_id" ref="bom_prep_pine"/>
        <field name="product_id" ref="aifa_base.product_raw_pineapple"/>
        <field name="product_qty">100.0</field>
        <field name="product_uom_id" ref="uom.product_uom_kgm"/>
