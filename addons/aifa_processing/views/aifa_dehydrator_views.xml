<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_aifa_dehydrator_tree" model="ir.ui.view">
        <field name="name">aifa.dehydrator.tree</field>
        <field name="model">aifa.dehydrator</field>
        <field name="arch" type="xml">
            <tree string="Dehydration Chambers" decoration-success="state == 'running'"
                  decoration-warning="state == 'maintenance'">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="dryer_type"/>
                <field name="tray_capacity"/>
                <field name="max_wet_load_kg"/>
                <field name="rated_power_kw"/>
                <field name="avg_yield_pct" optional="show"/>
                <field name="last_cip_date" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'running'"/>
            </tree>
        </field>
    </record>

    <record id="view_aifa_dehydrator_kanban" model="ir.ui.view">
        <field name="name">aifa.dehydrator.kanban</field>
        <field name="model">aifa.dehydrator</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard" default_group_by="state">
                <field name="state"/>
                <field name="current_run_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_card_content p-2">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="code"/> &#8212; <field name="name"/>
                                    </strong>
                                    <div class="text-muted"><field name="dryer_type"/></div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>Capacity: <field name="max_wet_load_kg"/> kg wet
                                     (<field name="tray_capacity"/> trays)</div>
                                <div t-if="record.current_run_id.raw_value">
                                    Running: <field name="current_run_id"/>
                                </div>
                                <div>Avg yield: <field name="avg_yield_pct"/>%</div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <button name="action_view_runs" type="object"
                                            class="btn btn-sm btn-link">Runs</button>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <button name="action_log_cip" type="object"
                                            class="btn btn-sm btn-secondary">Log CIP</button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_aifa_dehydrator_form" model="ir.ui.view">
        <field name="name">aifa.dehydrator.form</field>
        <field name="model">aifa.dehydrator</field>
        <field name="arch" type="xml">
            <form string="Dehydration Chamber">
                <header>
                    <button name="action_log_cip" type="object" string="Log Sanitation (CIP)"
                            class="btn-primary"/>
                    <button name="action_set_maintenance" type="object" string="Set Maintenance"
                            invisible="state == 'maintenance'"/>
                    <button name="action_set_idle" type="object" string="Set Idle"
                            invisible="state == 'idle'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="idle,loading,running,unloading"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_runs" type="object" class="oe_stat_button"
                                icon="fa-fire">
                            <field name="run_count" widget="statinfo" string="Runs"/>
                        </button>
                        <button name="action_view_runs" type="object" class="oe_stat_button"
                                icon="fa-bolt">
                            <field name="total_kwh" widget="statinfo" string="kWh"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Tunnel Dehydrator 1"/></h1>
                        <h3><field name="code" placeholder="TD-01"/></h3>
                    </div>
                    <group>
                        <group string="Equipment">
                            <field name="dryer_type"/>
                            <field name="workcenter_id"/>
                            <field name="location_id"/>
                            <field name="has_datalogger"/>
                            <field name="active" invisible="1"/>
                            <field name="current_run_id" readonly="1"/>
                            <field name="last_cip_date" readonly="1"/>
                        </group>
                        <group string="Capacity &amp; Energy">
                            <field name="tray_capacity"/>
                            <field name="kg_per_tray"/>
                            <field name="max_wet_load_kg"/>
                            <field name="rated_power_kw"/>
                            <field name="energy_tariff"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="temp_min"/>
                            <field name="temp_max"/>
                        </group>
                    </group>
                    <group string="Performance">
                        <field name="avg_yield_pct"/>
                        <field name="total_kwh"/>
                    </group>
                    <field name="note" placeholder="Airflow notes, baffle configuration, known cold spots..."/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_aifa_dehydrator" model="ir.actions.act_window">
        <field name="name">Dehydration Chambers</field>
        <field name="res_model">aifa.dehydrator</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a chamber</p>
            <p>The rated wet load is enforced when a run is created: overloading a
               chamber is the most common cause of under-dried centre trays, and
               under-dried fruit fails the water-activity gate downstream.</p>
        </field>
    </record>

</odoo>
