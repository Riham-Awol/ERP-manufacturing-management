    <!-- ================= Crops with calibrated standards ================= -->
    <record id="crop_pineapple" model="aifa.crop">
        <field name="name">Pineapple</field>
        <field name="code">PINE</field>
        <field name="sequence">10</field>
        <field name="color">3</field>
        <field name="raw_product_id" ref="product_raw_pineapple"/>
        <field name="prepped_product_id" ref="product_prep_pineapple"/>
        <field name="dried_product_id" ref="product_dry_pineapple"/>
        <field name="prep_yield_pct">55.0</field>
        <field name="dry_yield_pct">17.0</field>
        <field name="yield_tolerance_pct">3.0</field>
        <field name="target_moisture_pct">14.0</field>
        <field name="target_water_activity">0.60</field>
        <field name="min_brix">13.0</field>
        <field name="drying_temp_min">57.0</field>
        <field name="drying_temp_max">65.0</field>
        <field name="drying_hours_min">14.0</field>
        <field name="drying_hours_max">18.0</field>
        <field name="slice_thickness_mm">8.0</field>
        <field name="notes">Crown, shell and core removal is the dominant prep loss (~45%). Core can be diverted to a secondary juice/compost stream. Do not dry below aw 0.40 - the slices turn brittle and lose the pliable chew the brand is known for.</field>
    </record>
    <record id="crop_mango" model="aifa.crop">
        <field name="name">Mango</field>
        <field name="code">MANG</field>
        <field name="sequence">20</field>
        <field name="color">2</field>
        <field name="raw_product_id" ref="product_raw_mango"/>
        <field name="prepped_product_id" ref="product_prep_mango"/>
        <field name="dried_product_id" ref="product_dry_mango"/>
        <field name="prep_yield_pct">65.0</field>
        <field name="dry_yield_pct">20.0</field>
        <field name="yield_tolerance_pct">3.0</field>
        <field name="target_moisture_pct">15.0</field>
        <field name="target_water_activity">0.60</field>
        <field name="min_brix">14.0</field>
        <field name="drying_temp_min">55.0</field>
        <field name="drying_temp_max">62.0</field>
        <field name="drying_hours_min">12.0</field>
        <field name="drying_hours_max">16.0</field>
        <field name="slice_thickness_mm">7.0</field>
        <field name="notes">Peel + stone account for ~35% prep loss; stone share varies strongly by cultivar (Keitt lower, Tommy Atkins higher). Fibrous cultivars show wide moisture/aw scatter - sample 3 points per tray trolley, not one.</field>
    </record>
    <record id="crop_tomato" model="aifa.crop">
        <field name="name">Tomato</field>
        <field name="code">TOMA</field>
        <field name="sequence">30</field>
        <field name="color">1</field>
        <field name="raw_product_id" ref="product_raw_tomato"/>
        <field name="prepped_product_id" ref="product_prep_tomato"/>
        <field name="dried_product_id" ref="product_dry_tomato"/>
        <field name="prep_yield_pct">95.0</field>
        <field name="dry_yield_pct">7.2</field>
        <field name="yield_tolerance_pct">1.5</field>
        <field name="target_moisture_pct">12.0</field>
        <field name="target_water_activity">0.55</field>
        <field name="min_brix">4.5</field>
        <field name="drying_temp_min">55.0</field>
        <field name="drying_temp_max">60.0</field>
        <field name="drying_hours_min">14.0</field>
        <field name="drying_hours_max">20.0</field>
        <field name="slice_thickness_mm">10.0</field>
        <field name="notes">IMPORTANT: tomato is ~94% water, so its fresh-to-dried ratio is roughly 15:1, NOT the 8:1-10:1 used for pineapple and mango. Costing and capacity planning must use the per-crop factor. Halve rather than slice; dry cut-face up to limit juice loss to the tray.</field>
    </record>

