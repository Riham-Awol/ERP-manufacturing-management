<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_aifa_region_tree" model="ir.ui.view">
        <field name="name">aifa.region.tree</field>
        <field name="model">aifa.region</field>
        <field name="arch" type="xml">
            <tree string="Sourcing Regions">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="state_id"/>
                <field name="collection_centre_count" string="Centres"/>
            </tree>
        </field>
    </record>

    <record id="view_aifa_region_form" model="ir.ui.view">
        <field name="name">aifa.region.form</field>
        <field name="model">aifa.region</field>
        <field name="arch" type="xml">
            <form string="Sourcing Region">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Gamo / Arba Minch"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="GMA"/>
                            <field name="country_id"/>
                            <field name="state_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="gps_lat"/>
                            <field name="gps_lng"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Collection Centres" name="centres">
                            <field name="collection_centre_ids">
                                <tree editable="bottom">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="warehouse_id"/>
                                    <field name="has_cold_room"/>
                                    <field name="agent_ids" widget="many2many_tags"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Road access, harvest calendar, cooperative contacts..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_aifa_region" model="ir.actions.act_window">
        <field name="name">Sourcing Regions</field>
        <field name="res_model">aifa.region</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define a sourcing region</p>
            <p>Regions such as Gamo/Arba Minch, Sidama or Afar. The region code is
               embedded in every raw intake lot number, which is what makes a
               one-click recall traceable back to a geography.</p>
        </field>
    </record>

    <menuitem id="menu_aifa_region" name="Sourcing Regions"
              parent="menu_aifa_config_master" action="action_aifa_region" sequence="10"/>

</odoo>
