<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_aifa" model="ir.module.category">
        <field name="name">Aifa Agro-Processing</field>
        <field name="description">Operational personas for the Aifa Foods agro-processing plant.</field>
        <field name="sequence">18</field>
    </record>

    <!--
        Nine personas from FRS section 4.3.  They are deliberately modelled as
        implied-group chain only where a role is genuinely a superset; a QA
        Manager is NOT a superset of Finance, for example.
    -->
    <record id="group_aifa_field_agent" model="res.groups">
        <field name="name">Field Sourcing Agent</field>
        <field name="category_id" ref="module_category_aifa"/>
        <field name="comment">Registers outgrowers, weighs and buys fruit at rural collection centres.</field>
    </record>

    <record id="group_aifa_receiving" model="res.groups">
        <field name="name">Receiving Inspector</field>
        <field name="category_id" ref="module_category_aifa"/>
        <field name="comment">Performs gate reception, gross/tare weighing and raw intake QA.</field>
    </record>

    <record id="group_aifa_operator" model="res.groups">
        <field name="name">Processing Operator</field>
        <field name="category_id" ref="module_category_aifa"/>
        <field name="comment">Runs prep stations and dehydration chambers on the shop floor.</field>
    </record>

    <record id="group_aifa_packaging_lead" model="res.groups">
        <field name="name">Packaging Line Lead</field>
        <field name="category_id" ref="module_category_aifa"/>
        <field name="implied_ids" eval="[(4, ref('group_aifa_operator'))]"/>
    </record>

    <record id="group_aifa_qa_manager" model="res.groups">
        <field name="name">QA / QC Manager</field>
        <field name="category_id" ref="module_category_aifa"/>
        <field name="comment">Authorises quality gates, quarantine release, recalls and audit dossiers.</field>
        <field name="implied_ids" eval="[(4, ref('group_aifa_receiving'))]"/>
    </record>

    <record id="group_aifa_warehouse" model="res.groups">
        <field name="name">Warehouse Custodian</field>
        <field name="category_id" ref="module_category_aifa"/>
    </record>

    <record id="group_aifa_route_sales" model="res.groups">
        <field name="name">Route Sales / Van Driver</field>
        <field name="category_id" ref="module_category_aifa"/>
    </record>

    <record id="group_aifa_finance" model="res.groups">
        <field name="name">Finance Accountant</field>
        <field name="category_id" ref="module_category_aifa"/>
    </record>

    <record id="group_aifa_manager" model="res.groups">
        <field name="name">Executive / Plant Manager</field>
        <field name="category_id" ref="module_category_aifa"/>
        <field name="comment">Full read/write on the Aifa suite plus master data configuration.</field>
        <field name="implied_ids" eval="[(4, ref('group_aifa_field_agent')),
                                         (4, ref('group_aifa_qa_manager')),
                                         (4, ref('group_aifa_packaging_lead')),
                                         (4, ref('group_aifa_warehouse')),
                                         (4, ref('group_aifa_route_sales')),
                                         (4, ref('group_aifa_finance'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_aifa_collection_centre_company" model="ir.rule">
        <field name="name">Collection centre: multi-company</field>
        <field name="model_id" ref="model_aifa_collection_centre"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('warehouse_id.company_id', 'in', company_ids + [False])]</field>
    </record>

</odoo>
