    <record id="route_trip_demo" model="aifa.route.trip">
        <field name="date" eval="(DateTime.today() - relativedelta(days=1)).strftime('%Y-%m-%d')"/>
        <field name="zone">bole</field>
        <field name="vehicle_plate">3-D90211 AA</field>
        <field name="odometer_start">48210.0</field>
        <field name="odometer_end">48273.0</field>
    </record>
    <record id="route_stop_1" model="aifa.route.stop">
        <field name="trip_id" ref="route_trip_demo"/>
        <field name="sequence">10</field>
        <field name="partner_id" ref="partner_friendship"/>
        <field name="planned_time">9.0</field>
        <field name="payment_method">consignment</field>
    </record>
    <record id="route_stop_2" model="aifa.route.stop">
        <field name="trip_id" ref="route_trip_demo"/>
