<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="stock_location_consignment_root" model="stock.location">
            <field name="name">Consignment Shelves</field>
            <field name="usage">internal</field>
            <field name="location_id" ref="stock.stock_location_locations"/>
            <field name="comment">Parent of one internal location per retail partner. Stock here is still owned by Aifa Foods and still appears on the balance sheet, but it is physically on a supermarket shelf.</field>
        </record>
        <record id="stock_location_van" model="stock.location">
            <field name="name">Van Sales Stock</field>
            <field name="usage">internal</field>
            <field name="location_id" ref="stock.stock_location_locations"/>
        </record>
    </data>
</odoo>
